{
	"name": "architecture-decision-record.github.io",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Architecture Decision Record (ADR) guide — published website (SvelteKit + Lily Design System)",
	"scripts": {
		"dev": "node scripts/generate-manifest.mjs && vite dev",
		"build": "node scripts/generate-manifest.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"manifest": "node scripts/generate-manifest.mjs",
		"content": "node scripts/sync-content.mjs && node scripts/generate-manifest.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"mdsvex": "^0.12.8",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0",
		"vite": "^6.4.3"
	},
	"dependencies": {
		"lily-design-system-svelte-headless": "^0.3.1",
		"lily-design-system-svelte-share-picker": "^0.1.1",
		"lily-design-system-svelte-text-size-picker": "^0.1.1",
		"lily-design-system-svelte-theme-picker": "^0.1.1",
		"rehype-slug": "^6.0.0"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"esbuild"
		],
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
