{
	"name": "architecture-decision-record.github.io",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Architecture Decision Record (ADR) guide — published website (SvelteKit + Lily Design System)",
	"scripts": {
		"dev": "node scripts/generate-manifest.mjs && vite dev",
		"build": "node scripts/generate-manifest.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"manifest": "node scripts/generate-manifest.mjs",
		"content": "node scripts/sync-content.mjs && node scripts/generate-manifest.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"mdsvex": "^0.12.8",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@lilydesignsystem/svelte-headless": "^0.1.0",
		"@lilydesignsystem/svelte-locale-picker": "^0.1.0",
		"@lilydesignsystem/svelte-picker-bar": "^0.1.0",
		"@lilydesignsystem/svelte-share-picker": "^0.1.0",
		"@lilydesignsystem/svelte-text-size-picker": "^0.1.0",
		"@lilydesignsystem/svelte-theme-picker": "^0.1.0",
		"rehype-slug": "^6.0.0"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"esbuild"
		],
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
